# НАСТРОЙКИ API ДЛЯ ПОЛУЧЕНИЯ ГЕОГРАФИЧЕСКИХ КООРДИНАТ СТРАН
# Зарегистрируйтесь на https://nominatim.openstreetmap.org

# Базовый URL NOMINATIM
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# НАСТРОЙКИ API ДЛЯ ПОЛУЧЕНИЯ ИНФОРМАЦИИ О САМОЛЕТАХ
# Зарегистрируйтесь на https://opensky-network.org

# Базовый URL OPENSKY
# OPENSKY_URL= https://opensky-network.org/api/states/all

# GITHUB TOKEN
# Personal Access Token для GitHub
# Создайте на: https://github.com/settings/tokens
# Необходимые scope: repo, read:org, user (в зависимости от нужд)
GITHUB_TOKEN=your_github_token_here